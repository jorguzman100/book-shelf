# App
NODE_ENV=development
PORT=8090
SESSION_SECRET=<REDACTED_SESSION_SECRET>

# MySQL - development
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=good_reader_db
DB_USER=root
DB_PASSWORD=<REDACTED_DB_PASSWORD>

# MySQL - test (optional; falls back to DB_* when not set)
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_NAME=database_test
TEST_DB_USER=root
TEST_DB_PASSWORD=<REDACTED_DB_PASSWORD>

# Production (used when NODE_ENV=production)
JAWSDB_URL=<REDACTED_JAWSDB_URL>
